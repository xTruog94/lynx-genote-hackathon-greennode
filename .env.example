# Fill every secret locally. Do not commit this file after adding values.
# RELEASE_ASSET_KEY is delivered separately from genote-notebook.release.key.
RELEASE_ASSET_KEY=
DOCUMENT_STORAGE=s3
PORT=8080
GUNICORN_WORKERS=2
RUN_CELERY_WORKER=1
CELERY_CONCURRENCY=1

DB_HOST=<value>
DB_PORT=<value>
DB_NAME=<value>
DB_SCHEMA=genote_db
DB_USER=<value>
DB_PASSWORD="<value>"


LLM_PROVIDER="openai"  # or anthropic, azure-openai
OPENAI_API_KEY=<value>
OPENAI_BASE_URL=<value>
OPENAI_MODEL=<value>
EMBEDDING_MODEL=<value>



# Optional. Uploaded documents and VBPL HTML files are stored here.
# Inside Docker this is mounted from ./data/documents.
# LOCAL_DOCUMENT_DIR=/app/data/documents

S3_URL="<value>"
S3_ACCESS_KEY="<value>"
S3_SECRET_ACCESS_KEY="<value>"
S3_BUCKET_NAME="<value>"
S3_PREFIX="<value>"
S3_INPUT_SUB_PREFIX="<value>"


# Cronjob LLM/OCR bindings
LLM_BINDING_API_KEY=<value>
LLM_BINDING_HOST=<value>
LLM_MODEL=<value>
# Cronjob ETL log check
METADATA_EXCEL_FILE="metadata.xlsx"
ETL_CHECK_ENABLED="true"
ETL_LOG_HOST="<value>"
ETL_LOG_PORT="<value>"
ETL_LOG_DB="<value>"
ETL_LOG_USER="<value>"
ETL_LOG_PASSWORD="<value>"
ETL_LOG_SCHEMA="<value>"
ETL_LOG_TABLE="<value>"
ETL_JOB_NAME="<value>"
ETL_COB_DT="<value>"
ETL_SUCCESS_STATUS="S"
SOURCES="external"
CATEGORY="tvpl"
FOLDER_P="documents"


# PDF upload OCR runs in-process via the doc-ocr module (native text, else vision OCR).
# Settings use the DOC_OCR_* prefix; see doc-ocr/env.example. The app loads doc-ocr/.env
# when that file is present.

DEEPSEEK_API_URL=<value>
DEEPSEEK_MODEL_NAME=<value>
DEEPSEEK_SYSTEM_PROMPT="<image>\nFree OCR."
DEEPSEEK_MAX_TOKENS="6000"


# PPTX to video / TTS Configuration
TTS_API_URL="<value>"
TTS_TIMEOUT_SECONDS=20
PPTX_VIDEO_WORK_DIR="/tmp/vtb_notebook_pptx_video"
PPTX_VIDEO_OUTPUT_DIR="/tmp/vtb_notebook_pptx_video_outputs"
PPTX_VIDEO_MAX_UPLOAD_MB=100
PPTX_VIDEO_DEFAULT_SLIDE_SECONDS=4
PPTX_VIDEO_WIDTH=1280
PPTX_VIDEO_HEIGHT=720
PPTX_VIDEO_LIBREOFFICE_TIMEOUT_SECONDS=20
PPTX_VIDEO_FFMPEG_TIMEOUT_SECONDS=100
PPTX_VIDEO_KEEP_WORKDIR=true

DASHBOARD_ACCESS_TOKEN="<value>"

# Audio ASR Configuration
ASR_API_URL="<value>"
ASR_MODEL="<value>"


# Infographic Configuration
INFOGRAPHIC_MAX_CONTEXT_CHARS=1200000
INFOGRAPHIC_MAX_SPEC_CHARS=60000
INFOGRAPHIC_IMAGE_ENABLED=true

INFOGRAPHIC_IMAGE_SIZE="1536x1024"
INFOGRAPHIC_IMAGE_MODEL="azure/gpt-image-2"
INFOGRAPHIC_IMAGE_MAX_ASSETS=10
INFOGRAPHIC_IMAGE_ENDPOINT=""

# Infographic daily limit (times per day per user)
INFOGRAPHIC_DAILY_LIMIT=3

# Mindmap Configuration
MINDMAP_MAX_CONTEXT_CHARS=2000000
MINDMAP_MAX_MARKDOWN_CHARS=2000000




# Redis Sentinel / Celery Studio Job Queue
REDIS_SENTINEL_ADDRESSES_OCR=<value>
REDIS_SENTINEL_MASTER_NAME_OCR=<value>
REDIS_PASSWORD_OCR=<value>
REDIS_DATABASE_OCR=1
REDIS_SOCKET_TIMEOUT_OCR=2
REDIS_SENTINEL_PASSWORD_OCR=<value>

# Không dùng direct cố định nếu chưa chắc endpoint là master
REDIS_FORCE_DIRECT_MASTER_OCR=false
REDIS_MASTER_HOST_OCR=
REDIS_MASTER_PORT_OCR=6379
REDIS_BROKER_URL_OCR= 

# Bật resolve/fallback để nếu Sentinel lỗi thì probe danh sách Redis nodes
REDIS_RESOLVE_MASTER_FROM_SENTINEL_OCR=true
REDIS_SENTINEL_MASTER_HOST_MAP_OCR=

# Danh sách Redis data nodes, không phải Sentinel ports
REDIS_MASTER_ADDRESSES_OCR=<value>

CELERY_DEFAULT_QUEUE=studio
CELERY_VISIBILITY_TIMEOUT_SECONDS=7200
CELERY_TASK_TIME_LIMIT_SECONDS=3600
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=3300
CELERY_WORKER_PREFETCH_MULTIPLIER=1
STUDIO_JOB_STATUS_CACHE_TTL_SECONDS=86400



#AUTH
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD="<value>"
LOCAL_ADMIN_EMAIL=admin@local.notebook
SESSION_EXPIRE_DAYS=30
JWT_ACCESS_TOKEN_EXPORE_MINUTES=30
JWT_SECRET_KEY="<value>"
REFRESH_TOKEN_COOKIE_PATH="/"
REFRESH_TOKEN_COOKIE_SECURE=false

LDAP_HOST="<value>"
LDAP_PORT="<value>"
# LDAP_USE_SSL="false"
# LDAP_USE_TLS="false"
LDAP_USER_BASE="<value>"
LDAP_SEARCH_FILTER="(&(objectClass=user)(|(sAMAccountName={{username}})(mail={{username}})(userPrincipalName={{username}})))"
LDAP_BIND_DN="<value>"
LDAP_BIND_CREDENTIALS="<value>"

LDAP_ATTR_USERNAME="uid"
LDAP_ATTR_EMAIL="mail"
LDAP_ATTR_FULLNAME="cn"
LDAP_DEFAULT_ROLE="user"


# LDAP_URL=l_dap://<value>
# LDAP_BIND_DN=<value>
# LDAP_BIND_CREDENTIALS=<value>
# LDAP_USER_SEARCH_BASE=<value>
# LDAP_SEARCH_FILTER="(&(objectClass=user)(|(sAMAccountName={{username}})(mail={{username}})(userPrincipalName={{username}})))"
# LDAP_CA_CERT_PATH= 

FLOWER_BASE=<value>
FLOWER_UNAUTHENTICATED_API=true  


# =========================
# Web search
# =========================
WEB_SEARCH_API_URL="<value>"
WEB_SEARCH_API_KEY="<value>"
WEB_SEARCH_PAGES=1
WEB_SEARCH_MAX_URLS=5
WEB_SEARCH_MAX_ARTICLES=5
WEB_SEARCH_MAX_CHARS_PER_ARTICLE=100000
WEB_SEARCH_SITES="<value>"
WEB_SEARCH_DEBUG=true
WEB_SEARCH_BACKEND="searxng" #  searxng: search qua searxng -> duckduckgo   |     ddgs: search thẳng duckduckgo  
WEB_SEARCH_TIMEOUT_SECONDS=3000
WEB_SEARCH_MAX_CONTEXT_CHARS=120000




# Graph View / title embedding
# OpenAI embeddings API. Do not point this at LLM_BINDING_HOST.
EMBEDDING_BASE_URL="<value>"
EMBEDDING_MODEL="text-embedding-3-large"
EMBEDDING_DIM=3072
TITLE_EMBEDDING_MODEL="text-embedding-3-large"
TITLE_EMBEDDING_DIM=3072
TITLE_EMBEDDING_BATCH_SIZE=32
TITLE_EMBEDDING_SLEEP_MS=200
GRAPH_DEFAULT_SIMILARITY_THRESHOLD=0.5
GRAPH_DEFAULT_MAX_NODES=300
GRAPH_DEFAULT_MAX_EDGES_PER_NODE=100
GRAPH_DEFAULT_SIMILARITY_TOP_K=100
GRAPH_MAX_NODES_HARD_LIMIT=1000
GRAPH_DISPLAY_SIMILARITY_THRESHOLD=0.7


WEB_SEARCH_ENABLE=true
GRAPH_VIEW_ENABLE=true


# VBPL Evaluation access token. Users must enter this token before using Đánh giá VBPL.
VBPL_EVALUATION_ACCESS_TOKEN="<value>"

AGENT_HARNESS_ENABLE=true
AGENT_HARNESS_STUDIO_JOBS_ENABLE=true
